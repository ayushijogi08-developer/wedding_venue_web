# Enquiry Form Email Delivery Configuration
# Choose either Resend OR Formspree by populating the corresponding environment variables.
# If neither is set, the API will run in mock mode and return success in development.

# Option 1: Resend
RESEND_API_KEY=
RESEND_TO_EMAIL=admin@example.com

# Option 2: Formspree
FORMSPREE_ENDPOINT=

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
